# Build de producción (`vite build`, también en Vercel, producción y previews):
# datos reales del backend de Render. Así no depende de las variables del
# panel de Vercel ni del entorno (Production/Preview) en que se compile.
VITE_VIGOBUS_MOCK=false
VITE_VIGOBUS_API_URL=https://vigobus-api.onrender.com
