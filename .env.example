# Por defecto el servicio devuelve respuestas simuladas
# (src/services/vigobusMock.js). Pon `false` para hacer peticiones reales.
# En Vercel: `false`.
VITE_VIGOBUS_MOCK=true

# URL del backend (`backend/`) que usa el navegador. Vacía = `/vigobus`, que
# Vite reenvía al backend local. En Vercel: la URL de Render, p. ej.
# https://vigobus-api.onrender.com (el backend permite ese origen por CORS).
VITE_VIGOBUS_API_URL=

# Destino del proxy `/vigobus` de Vite (se lee del entorno al arrancar Vite).
# VIGOBUS_PROXY_TARGET=http://localhost:5000
